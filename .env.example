# Скопируйте в ~/.config/draft-party/opencode.env или задайте переменными systemd.
OPENCODEGO_BASE_URL=https://opencode.ai/inference/openai/v1
OPENCODEGO_MODEL=gpt-6-luna
OPENCODEGO_API_KEY=
TMDB_READ_ACCESS_TOKEN=
# Токен для детального /health (без него наружу видны только ok и uptime).
LOT_OPS_TOKEN=
# Публичный адрес дома: по нему модель-проверщик смотрит скачанные картинки.
LOT_PUBLIC_URL=
