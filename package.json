{
  "name": "the-lot",
  "version": "1.0.0",
  "description": "The Lot — a two-player draft house (Bun + Datastar)",
  "license": "MIT",
  "homepage": "https://lot.bunker9.lol",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/M1XXRON/the-lot.git"
  },
  "private": true,
  "type": "module",
  "scripts": {
    "start": "bun run server.ts",
    "dev": "bun --watch run server.ts",
    "test": "bun test/sim-bun.mjs",
    "test:http": "bun tools/http-e2e.mjs",
    "test:ui": "bun tools/ui-e2e.mjs",
    "verify": "bun tools/verify.mjs",
    "shots": "bun tools/shot.mjs",
    "sim": "bun tools/balance-sim.mjs",
    "norms": "bun tools/norms-check.mjs",
    "build": "bun build ./server.ts --compile --bytecode --target=bun-linux-x64 --outfile dist/lot",
    "build:local": "bun build ./server.ts --compile --bytecode --outfile dist/lot-local",
    "start:bin": "./dist/lot"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "playwright": "1.65.0"
  }
}
